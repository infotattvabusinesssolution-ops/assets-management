datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/maintenance-client-v5"
}

// ------------------------------------------------------
// ENUMS
// ------------------------------------------------------

// Enums mapped to String types for MS SQL Server compatibility

// ------------------------------------------------------
// ORGANIZATIONAL HIERARCHY
// ------------------------------------------------------

model Company {
  id            String   @id @default(uuid())
  legacyMongoId String?
  code          String   @unique
  name          String
  currency      String   @default("USD")
  taxId         String?
  address       String?
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  departments      Department[]
  costCenters      CostCenter[]
  sites            Site[]
  employees        Employee[]
  assets           Asset[]
  users            User[]
  fiscalPeriods    FiscalPeriod[]
  depreciationRuns DepreciationRun[]
  receipts         Receipt[]

  @@map("companies")
}

model Department {
  id            String   @id @default(uuid())
  legacyMongoId String?
  companyId     String
  code          String
  name          String
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  company   Company    @relation(fields: [companyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  employees Employee[]
  assets    Asset[]
  users     User[]

  @@unique([companyId, code])
  @@map("departments")
}

model CostCenter {
  id            String   @id @default(uuid())
  legacyMongoId String?
  companyId     String
  code          String
  name          String
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  company   Company    @relation(fields: [companyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  employees Employee[]
  assets    Asset[]
  users     User[]

  @@unique([companyId, code])
  @@map("cost_centers")
}

model Site {
  id            String   @id @default(uuid())
  legacyMongoId String?
  companyId     String
  code          String
  name          String
  city          String?
  country       String?
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  company   Company    @relation(fields: [companyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  buildings Building[]
  assets    Asset[]
  users     User[]
  receipts  Receipt[]

  @@unique([companyId, code])
  @@map("sites")
}

model Building {
  id            String   @id @default(uuid())
  legacyMongoId String?
  siteId        String
  code          String
  name          String
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  site   Site    @relation(fields: [siteId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  floors Floor[]
  assets Asset[]

  @@map("buildings")
}

model Floor {
  id            String   @id @default(uuid())
  legacyMongoId String?
  buildingId    String
  code          String
  name          String
  floorNumber   Int?
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  building Building  @relation(fields: [buildingId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  rooms    Room[]
  assets   Asset[]
  floorMap FloorMap?

  @@map("floors")
}

model Room {
  id            String   @id @default(uuid())
  legacyMongoId String?
  floorId       String
  code          String
  name          String
  roomType      String   @default("General")
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  floor  Floor   @relation(fields: [floorId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  zones  Zone[]
  assets Asset[]

  @@map("rooms")
}

model Zone {
  id            String   @id @default(uuid())
  legacyMongoId String?
  roomId        String
  code          String
  name          String
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  room         Room               @relation(fields: [roomId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  assets       Asset[]
  mapZones     FloorMapZone[]
  mapPositions AssetMapPosition[]

  @@map("zones")
}

model Employee {
  id            String   @id @default(uuid())
  legacyMongoId String?
  employeeCode  String   @unique
  fullName      String
  email         String
  companyId     String
  departmentId  String?
  costCenterId  String?
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  company    Company     @relation(fields: [companyId], references: [id])
  department Department? @relation(fields: [departmentId], references: [id])
  costCenter CostCenter? @relation(fields: [costCenterId], references: [id])

  custodyAssets  Asset[]                @relation("AssetCustodian")
  custodyRecords CustodyAssignment[]
  users          User[]
  transfersFrom  AssetTransfer[]        @relation("TransferFromCustodian")
  transfersTo    AssetTransfer[]        @relation("TransferToCustodian")
  stocktakeObs   StocktakeObservation[]

  @@map("employees")
}

// ------------------------------------------------------
// CLASSIFICATIONS
// ------------------------------------------------------

model Category {
  id                          String             @id @default(uuid())
  legacyMongoId               String?
  code                        String             @unique
  name                        String
  description                 String?
  depreciationMethod          String             @default("STRAIGHT_LINE")
  annualDepreciationRatePercent Decimal?           @db.Decimal(5, 2)
  defaultUsefulLifeMonths     Int                @default(60)
  defaultResidualValuePercent Decimal            @default(0) @db.Decimal(5, 2)
  isSerialized                Boolean            @default(true)
  active                      Boolean            @default(true)
  createdAt                   DateTime           @default(now())
  updatedAt                   DateTime           @updatedAt

  assetClasses     AssetClass[]
  models           AssetModel[]
  assets           Asset[]
  customFields     CustomFieldDefinition[]
  receiptLineItems ReceiptLineItem[]

  @@map("categories")
}

model AssetClass {
  id            String   @id @default(uuid())
  legacyMongoId String?
  code          String   @unique
  name          String
  categoryId    String
  description   String?
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  category Category @relation(fields: [categoryId], references: [id])
  assets   Asset[]

  @@map("asset_classes")
}

model Manufacturer {
  id             String   @id @default(uuid())
  legacyMongoId  String?
  name           String   @unique
  supportContact String?
  website        String?
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  models AssetModel[]
  assets Asset[]

  @@map("manufacturers")
}

model AssetModel {
  id             String   @id @default(uuid())
  legacyMongoId  String?
  modelNumber    String
  name           String
  manufacturerId String
  categoryId     String
  specifications String?
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  manufacturer Manufacturer @relation(fields: [manufacturerId], references: [id])
  category     Category     @relation(fields: [categoryId], references: [id])
  assets       Asset[]

  @@map("asset_models")
}

// ------------------------------------------------------
// CORE ASSET
// ------------------------------------------------------

model Asset {
  id            String  @id @default(uuid())
  legacyMongoId String?
  assetId       String  @unique
  legacyId      String?
  tagNumber     String? @unique
  barcode       String?
  qrCode        String?
  rfidEpc       String?
  rfidTid       String?
  serialNumber  String?
  description   String

  categoryId     String
  assetClassId   String?
  manufacturerId String?
  modelId        String?
  parentAssetId  String?

  lifecycleStatus String @default("RECEIVED")
  condition       String @default("NEW")
  criticality     String @default("MEDIUM")

  companyId    String
  siteId       String
  buildingId   String?
  floorId      String?
  roomId       String?
  zoneId       String?
  departmentId String?
  costCenterId String?

  custodianId  String?
  assignedDate DateTime?

  poNumber         String?
  supplierName     String?
  purchaseDate     DateTime?
  inServiceDate    DateTime?
  acquisitionValue Decimal   @default(0) @db.Decimal(18, 2)
  currency         String    @default("USD")

  hostname    String?
  macAddress  String?
  ipAddress   String?
  discoveryId String?

  healthScore Int @default(100)

  createdByUserId String?
  updatedByUserId String?
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  category     Category      @relation(fields: [categoryId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  assetClass   AssetClass?   @relation(fields: [assetClassId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  manufacturer Manufacturer? @relation(fields: [manufacturerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  model        AssetModel?   @relation(fields: [modelId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  parentAsset  Asset?        @relation("ChildAssets", fields: [parentAssetId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  childAssets  Asset[]       @relation("ChildAssets")

  company    Company     @relation(fields: [companyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  site       Site        @relation(fields: [siteId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  building   Building?   @relation(fields: [buildingId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  floor      Floor?      @relation(fields: [floorId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  room       Room?       @relation(fields: [roomId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  zone       Zone?       @relation(fields: [zoneId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  department Department? @relation(fields: [departmentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  costCenter CostCenter? @relation(fields: [costCenterId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  custodian  Employee?   @relation("AssetCustodian", fields: [custodianId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  creator User? @relation("AssetCreator", fields: [createdByUserId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  updater User? @relation("AssetUpdater", fields: [updatedByUserId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  // Dependent Relational Lists
  customFieldValues  AssetCustomFieldValue[]
  bookValues         AssetBookValue[]
  custodyAssignments CustodyAssignment[]
  transfers          AssetTransfer[]
  workOrders         MaintenanceWorkOrder[]
  schedules          MaintenanceSchedule[]
  contractLinks      ContractAsset[]
  warranty           Warranty?
  tags               Tag[]
  tagHistories       TagHistory[]
  mapPosition        AssetMapPosition?
  discoveryMatches   DiscoveryMatch[]
  aiRecommendations  AIRecommendation[]
  transactions       AssetTransaction[]
  rtlsLocation       RtlsAssetLocation?
  rtlsMovements      RtlsMovement[]

  @@index([companyId, siteId, categoryId, lifecycleStatus])
  @@index([assetId, serialNumber, tagNumber, barcode, hostname])
  @@map("assets")
}

model AssetCustomFieldValue {
  id               String    @id @default(uuid())
  assetId          String
  customFieldDefId String
  textValue        String?
  numberValue      Decimal?  @db.Decimal(18, 4)
  dateValue        DateTime?
  booleanValue     Boolean?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  asset          Asset                 @relation(fields: [assetId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  customFieldDef CustomFieldDefinition @relation(fields: [customFieldDefId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([assetId, customFieldDefId])
  @@map("asset_custom_field_values")
}

model CustomFieldDefinition {
  id            String    @id @default(uuid())
  legacyMongoId String?
  name          String    @unique
  label         String
  fieldType     String
  required      Boolean   @default(false)
  defaultValue  String?
  options       String?
  categoryId    String?
  active        Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  category Category?               @relation(fields: [categoryId], references: [id])
  values   AssetCustomFieldValue[]

  @@map("custom_field_definitions")
}

model AssetTransaction {
  id                String   @id @default(uuid())
  assetId           String
  transactionType   String
  fromStatus        String?
  toStatus          String?
  performedByUserId String
  timestamp         DateTime @default(now())
  notes             String?
  payload           String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  asset       Asset @relation(fields: [assetId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  performedBy User  @relation(fields: [performedByUserId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([assetId, timestamp])
  @@map("asset_transactions")
}

// ------------------------------------------------------
// USER, SECURITY & AUTHORIZATION (RBAC + DATA SCOPE)
// ------------------------------------------------------

model User {
  id            String    @id @default(uuid())
  legacyMongoId String?
  username      String    @unique
  email         String    @unique
  passwordHash  String
  fullName      String
  phone         String?
  roleId        String
  companyId     String?
  siteId        String?
  departmentId  String?
  costCenterId  String?
  employeeId    String?
  active        Boolean   @default(true)
  lastLogin     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  role       Role        @relation(fields: [roleId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  company    Company?    @relation(fields: [companyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  site       Site?       @relation(fields: [siteId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  department Department? @relation(fields: [departmentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  costCenter CostCenter? @relation(fields: [costCenterId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  employee   Employee?   @relation(fields: [employeeId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  dataScopes          UserDataScope[]
  createdAssets       Asset[]                @relation("AssetCreator")
  updatedAssets       Asset[]                @relation("AssetUpdater")
  issuedCustodies     CustodyAssignment[]    @relation("CustodyIssuer")
  requestedTransfers  AssetTransfer[]        @relation("TransferRequester")
  approvedTransfers   AssetTransfer[]        @relation("TransferApprover")
  receivedTransfers   AssetTransfer[]        @relation("TransferReceiver")
  workOrdersAssigned  MaintenanceWorkOrder[] @relation("TechnicianWorkOrders")
  workOrdersCreated   MaintenanceWorkOrder[] @relation("CreatedWorkOrders")
  auditEvents         AuditEvent[]
  notifications       Notification[]
  postedDepreciations DepreciationRun[]
  importJobs          ImportJob[]
  assetTransactions   AssetTransaction[]

  @@map("users")
}

model Role {
  id            String   @id @default(uuid())
  legacyMongoId String?
  name          String   @unique
  code          String   @unique
  description   String?
  permissions   String?
  isSystem      Boolean  @default(false)
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  users User[]

  @@map("roles")
}

model DataScope {
  id            String   @id @default(uuid())
  legacyMongoId String?
  name          String
  companyIds    String?
  siteIds       String?
  departmentIds String?
  costCenterIds String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  userAssignments UserDataScope[]

  @@map("data_scopes")
}

model UserDataScope {
  userId      String
  dataScopeId String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  dataScope   DataScope @relation(fields: [dataScopeId], references: [id], onDelete: Cascade)

  @@id([userId, dataScopeId])
  @@map("user_data_scopes")
}

model AuditEvent {
  id          String   @id @default(uuid())
  userId      String?
  action      String
  entityType  String
  entityId    String?
  beforeState String?
  afterState  String?
  ipAddress   String?
  userAgent   String?
  timestamp   DateTime @default(now())
  createdAt   DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([userId, entityType, timestamp])
  @@map("audit_events")
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  title     String
  message   String
  type      String           @default("INFO")
  read      Boolean          @default(false)
  link      String?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

// ------------------------------------------------------
// CUSTODY & TRANSFERS
// ------------------------------------------------------

model CustodyAssignment {
  id                  String    @id @default(uuid())
  legacyMongoId       String?
  assetId             String
  custodianId         String
  issuedDate          DateTime  @default(now())
  expectedReturnDate  DateTime?
  actualReturnDate    DateTime?
  conditionAtIssue    String?
  conditionAtReturn   String?
  issuedByUserId      String
  acknowledged        Boolean   @default(false)
  acknowledgementDate DateTime?
  active              Boolean   @default(true)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  asset     Asset    @relation(fields: [assetId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  custodian Employee @relation(fields: [custodianId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  issuedBy  User     @relation("CustodyIssuer", fields: [issuedByUserId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("custody_assignments")
}

model AssetTransfer {
  id             String       @id @default(uuid())
  legacyMongoId  String?
  transferNumber String       @unique
  assetId        String
  transferType   String

  fromCompanyId   String?
  fromSiteId      String?
  fromRoomId      String?
  fromCustodianId String?

  toCompanyId   String?
  toSiteId      String?
  toRoomId      String?
  toCustodianId String?

  status            String @default("DRAFT")
  reason            String?
  requestedByUserId String
  approvedByUserId  String?
  receivedByUserId  String?
  dispatchDate      DateTime?
  receiveDate       DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  asset         Asset     @relation(fields: [assetId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  fromCustodian Employee? @relation("TransferFromCustodian", fields: [fromCustodianId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  toCustodian   Employee? @relation("TransferToCustodian", fields: [toCustodianId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  requestedBy   User      @relation("TransferRequester", fields: [requestedByUserId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  approvedBy    User?     @relation("TransferApprover", fields: [approvedByUserId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  receivedBy    User?     @relation("TransferReceiver", fields: [receivedByUserId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("asset_transfers")
}

// ------------------------------------------------------
// FINANCIAL & DEPRECIATION
// ------------------------------------------------------

model AssetBookValue {
  id                      String             @id @default(uuid())
  legacyMongoId           String?
  assetId                 String
  bookType                String             @default("CORPORATE")
  capitalizationDate      DateTime?
  capitalizationValue     Decimal            @db.Decimal(18, 2)
  usefulLifeMonths        Int
  depreciationMethod      String             @default("STRAIGHT_LINE")
  annualDepreciationRatePercent Decimal?       @db.Decimal(5, 2)
  residualValue           Decimal            @default(0) @db.Decimal(18, 2)
  accumulatedDepreciation Decimal            @default(0) @db.Decimal(18, 2)
  netBookValue            Decimal            @db.Decimal(18, 2)
  isLocked                Boolean            @default(false)
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt

  asset Asset @relation(fields: [assetId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([assetId, bookType])
  @@map("asset_book_values")
}

model FiscalPeriod {
  id             String    @id @default(uuid())
  legacyMongoId  String?
  companyId      String
  year           Int
  periodNumber   Int
  periodName     String?
  startDate      DateTime
  endDate        DateTime
  isClosed       Boolean   @default(false)
  closedAt       DateTime?
  closedByUserId String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  company             Company             @relation(fields: [companyId], references: [id])
  depreciationRuns    DepreciationRun[]
  depreciationEntries DepreciationEntry[]

  @@unique([companyId, year, periodNumber])
  @@map("fiscal_periods")
}

model DepreciationRun {
  id                      String                @id @default(uuid())
  legacyMongoId           String?
  runNumber               String                @unique
  companyId               String
  fiscalPeriodId          String
  bookType                String                @default("CORPORATE")
  status                  String                @default("DRAFT")
  totalAssetsProcessed    Int                   @default(0)
  totalDepreciationAmount Decimal               @default(0) @db.Decimal(18, 2)
  postedAt                DateTime?
  postedByUserId          String?
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt

  company      Company             @relation(fields: [companyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  fiscalPeriod FiscalPeriod        @relation(fields: [fiscalPeriodId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  postedBy     User?               @relation(fields: [postedByUserId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  entries      DepreciationEntry[]

  @@map("depreciation_runs")
}

model DepreciationEntry {
  id                      String   @id @default(uuid())
  legacyMongoId           String?
  depreciationRunId       String
  assetId                 String
  fiscalPeriodId          String
  openingNetBookValue     Decimal  @db.Decimal(18, 2)
  depreciationAmount      Decimal  @db.Decimal(18, 2)
  accumulatedDepreciation Decimal  @db.Decimal(18, 2)
  closingNetBookValue     Decimal  @db.Decimal(18, 2)
  isPosted                Boolean  @default(false)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  depreciationRun DepreciationRun @relation(fields: [depreciationRunId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  fiscalPeriod    FiscalPeriod    @relation(fields: [fiscalPeriodId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([depreciationRunId, assetId])
  @@map("depreciation_entries")
}

// ------------------------------------------------------
// MAINTENANCE & WORK ORDERS
// ------------------------------------------------------

model MaintenanceSchedule {
  id                String    @id @default(uuid())
  legacyMongoId     String?
  title             String
  description       String?
  workType          String    @default("PREVENTIVE")
  assetId           String
  frequencyMonths   Int       @default(6)
  lastPerformedDate DateTime?
  nextDueDate       DateTime
  active            Boolean   @default(true)
  autoGenerateWorkOrders Boolean @default(false)
  advanceDays       Int       @default(7)
  checklistJson     String?   @db.NVarChar(Max)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  asset Asset @relation(fields: [assetId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("maintenance_schedules")
}

model MaintenanceScheduleRun {
  id          String   @id @default(uuid()) @db.NVarChar(36)
  scheduleId  String   @db.NVarChar(36)
  workOrderId String   @db.NVarChar(36)
  dueDate     DateTime
  createdAt   DateTime @default(now())

  @@unique([scheduleId, dueDate])
  @@map("maintenance_schedule_runs")
}

model MaintenancePlan {
  id                   String   @id @default(uuid()) @db.NVarChar(36)
  planNumber           String   @unique @db.NVarChar(50)
  companyId            String?
  name                 String
  description          String?
  workType             String   @default("PREVENTIVE")
  applyToRule          String   @default("CATEGORY")
  categoryId           String?
  siteId               String?
  custodianId          String?
  assetIdsJson         String?  @db.NVarChar(Max)
  frequencyMonths      Int      @default(6)
  nextDueDate          DateTime
  active               Boolean  @default(true)
  autoCreateWorkOrders Boolean  @default(false)
  advanceDays          Int      @default(7)
  createdByUserId      String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  checklist MaintenancePlanChecklist[]
  comments  MaintenancePlanComment[]
  events    MaintenancePlanEvent[]
  runs      MaintenancePlanRun[]

  @@index([active, nextDueDate])
  @@map("maintenance_plans")
}

model MaintenancePlanChecklist {
  id        String   @id @default(uuid()) @db.NVarChar(36)
  planId    String   @db.NVarChar(36)
  task      String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  plan      MaintenancePlan @relation(fields: [planId], references: [id], onDelete: Cascade)


// ------------------------------------------------------
// REAL-TIME LOCATION TRACKING (RTLS) & RFID READERS
// ------------------------------------------------------

// RTLS Enums mapped to String types for MS SQL Server compatibility

model RtlsReader {
  id               String           @id @default(uuid())
  readerIdentifier String           @unique
  name             String
  manufacturer     String           @default("Impinj")
  modelName        String?          @default("Speedway R420")
  ipAddress        String?
  macAddress       String?
  siteId           String
  buildingId       String?
  floorId          String?
  zoneId           String?
  status           String           @default("ONLINE")
  lastHeartbeat    DateTime         @default(now())
  firmwareVersion  String?          @default("v5.14.0")
  enabled          Boolean          @default(true)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  antennas   RtlsAntenna[]
  events     RfidEvent[]
  locations  RtlsAssetLocation[]
  movements  RtlsMovement[]
  heartbeats RtlsReaderHeartbeat[]
  alerts     RtlsAlert[]

  @@map("rtls_readers")
}

model RtlsAntenna {
  id            String   @id @default(uuid())
  readerId      String
  antennaNumber Int
  name          String
  zoneId        String?
  direction     String?  @default("OMNIDIRECTIONAL")
  enabled       Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  reader    RtlsReader          @relation(fields: [readerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  events    RfidEvent[]
  locations RtlsAssetLocation[]
  movements RtlsMovement[]

  @@unique([readerId, antennaNumber])
  @@map("rtls_antennas")
}

model RfidEvent {
  id               String   @id @default(uuid())
  epc              String
  tid              String?
  readerId         String
  antennaId        String?
  rssi             Int?     @default(-55)
  rawPayload       String?
  timestamp        DateTime @default(now())
  processedAt      DateTime @default(now())
  processingStatus String   @default("PROCESSED")

  reader  RtlsReader   @relation(fields: [readerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  antenna RtlsAntenna? @relation(fields: [antennaId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([epc, timestamp])
  @@index([readerId, timestamp])
  @@map("rfid_events")
}

model RtlsAssetLocation {
  id         String   @id @default(uuid())
  assetId    String   @unique
  zoneId     String?
  readerId   String?
  antennaId  String?
  confidence Int      @default(90)
  firstSeen  DateTime @default(now())
  lastSeen   DateTime @default(now())
  source     String   @default("RFID_RTLS")
  xRatio     Decimal? @db.Decimal(6, 4)
  yRatio     Decimal? @db.Decimal(6, 4)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  asset   Asset        @relation(fields: [assetId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  reader  RtlsReader?  @relation(fields: [readerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  antenna RtlsAntenna? @relation(fields: [antennaId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("rtls_asset_locations")
}

model RtlsMovement {
  id         String   @id @default(uuid())
  assetId    String
  fromZoneId String?
  toZoneId   String?
  readerId   String?
  antennaId  String?
  detectedAt DateTime @default(now())
  direction  String?  @default("TRANSIT")
  confidence Int      @default(90)
  eventId    String?
  createdAt  DateTime @default(now())

  asset   Asset        @relation(fields: [assetId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  reader  RtlsReader?  @relation(fields: [readerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  antenna RtlsAntenna? @relation(fields: [antennaId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([assetId, detectedAt])
  @@map("rtls_movements")
}

model RtlsReaderHeartbeat {
  id        String   @id @default(uuid())
  readerId  String
  timestamp DateTime @default(now())
  status    String   @default("ONLINE")
  latencyMs Int      @default(12)
  errorInfo String?
  createdAt DateTime @default(now())

  reader RtlsReader @relation(fields: [readerId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([readerId, timestamp])
  @@map("rtls_reader_heartbeats")
}

model RtlsAlert {
  id               String            @id @default(uuid())
  alertType        String
  severity         String            @default("HIGH")
  message          String
  assetId          String?
  readerId         String?
  zoneId           String?
  status           String            @default("OPEN")
  createdAt        DateTime          @default(now())
  resolvedAt       DateTime?
  resolvedByUserId String?

  reader RtlsReader? @relation(fields: [readerId], references: [id])

  @@index([status, createdAt])
  @@map("rtls_alerts")
}

// ------------------------------------------------------
// DISCOVERY SETTINGS
// ------------------------------------------------------

model DiscoveryCredential {
  id               String   @id @default(uuid())
  credentialName   String
  credentialType   String   // e.g., "WMI", "SNMP", "Active Directory"
  username         String?
  passwordValue    String   // Encrypted
  domainIpAddress  String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("discovery_credentials")
}
